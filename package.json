    "@mantine/form": "9.5.2",
    "@mantine/hooks": "9.5.2",
    "@mantine/modals": "9.5.2",
    "@mantine/notifications": "9.5.2",
    "@mantine/nprogress": "9.5.2",
    "@mantine/spotlight": "9.5.2",
    "@mantine/tiptap": "9.5.2",
